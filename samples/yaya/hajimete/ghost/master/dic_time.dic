//==============================================================
// dic_time.dic  時報
//   はじめてのゴースト（YAYA 版） 第11章
//
//   OnHourTimeSignal は SSP のイベント。毎正時に呼ばれる。
//==============================================================

OnHourTimeSignal
{
	"\1\s[10]\0\s[0]"
	--
	時報のことば
	--
	"\e"
}

時報のことば
{
	case hour {
		when 0 {
			"0時だよ。日付が変わったね。"
		}
		when 1-4 {
			"%(hour)時……。\w9\nユーザーさん、そろそろ寝たほうがいいよ。"
		}
		when 7 {
			"7時！　朝ごはん、ちゃんと食べた？"
		}
		when 12 {
			"お昼の12時。ごはんの時間だよ。"
		}
		when 15 {
			"3時だよ。\w9\1おやつの時間だぴ！"
		}
		others {
			"%(hour)時になったよ。"
		}
	}
}
