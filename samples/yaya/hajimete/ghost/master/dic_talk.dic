//==============================================================
// dic_talk.dic  ランダムトーク
//   はじめてのゴースト（YAYA 版） 第10章・第11章
//==============================================================

// システム辞書が aitalkinterval 秒ごとに呼び出す
OnAiTalk : nonoverlap
{
	//---- ここから第10章の10個 ----

	// 1
	"\1\s[10]\0\s[0]ねえぴーすけ、窓の外を見て。\w9\1……ここはデスクトップだから、窓はないぴ。\w9\0\s[1]あ、そっか。\e"

	// 2
	"\1\s[10]\0\s[0]ユーザーさんのデスクトップ、けっこうにぎやかだね。\w9\n\nアイコン、ときどき整理してあげてね。\e"

	// 3
	"\0\s[0]\1\s[10]オレ、本気を出せば空も飛べるんだぴ。\w9\0\s[2]え、飛んでるとこ見たことないよ？\w9\1\s[11]……今日は気分じゃないだけだぴ。\e"

	// 4 関数の埋め込み
	"\1\s[10]\0\s[0]わたしの好きなもの？\w9\n\nうーん……%(ことねの好きなもの)かな。\e"

	// 5 システム辞書の時刻を埋め込む
	"\1\s[10]\0\s[0]いま%(hour)時%(minute)分。\w9\n\nユーザーさん、ちょっと休憩しない？\e"

	// 6 システム辞書の変数（累計起動回数）を埋め込む
	"\1\s[10]\0\s[0]わたしたちが起動したの、これで%(ghostuptimes)回目なんだって。\w9\1数えてたのかぴ。\e"

	// 7 ローカル変数を使う関数
	サイコロトーク

	// 8
	"\1\s[10]\0\s[0]ぴーすけって、何歳なの？\w9\1それはヒミツだぴ。\w9\0……もしかして、覚えてないとか。\w9\1\s[11]ぴっ。\e"

	// 9
	"\1\s[10]\0\s[5]ユーザーさん、お水飲んでる？\w9\n\nわたしはさっきお茶を飲んだよ。\w9\1オレは水浴びしたぴ。\e"

	// 10 出力確定子を使う関数
	おやつトーク

	//---- ここから第11章で追加 ----

	// 配列と添字
	"\1\s[10]\0\s[0]もうすっかり%(季節のことば)だね。\w9\1季節が変わるのは早いぴ。\e"

	// foreach で配列を回す
	持ち物トーク

	// 夜ふかしの時間だけ増える候補
	if hour >= 22 || hour < 5 {
		"\1\s[10]\0\s[0]ふあぁ……そろそろ眠くなってきちゃった。\w9\1夜ふかしは体に悪いぴ。\e"
	}
}

ことねの好きなもの
{
	"日なたぼっこ"
	"いちごのショートケーキ"
	"ユーザーさんとのおしゃべり"
}

サイコロトーク
{
	_目 = RAND(6) + 1
	"\1\s[10]\0\s[0]サイコロ振るよ、えいっ。\w9\w9\n\n……%(_目)が出たよ！\w9\1次はオレの番だぴ。\e"
}

おやつトーク
{
	"\1\s[10]\0\s[0]今日のおやつは"
	--
	"いちごのショートケーキ"
	"みたらし団子"
	"ポテトチップス"
	--
	"がいいなあ。\w9\1"
	--
	"オレの分もよろしくだぴ。\e"
	"オレはひまわりの種で十分だぴ。\e"
}

// 第11章：配列から月に合った季節を取り出す
季節のことば
{
	_季節 = ("冬", "冬", "春", "春", "春", "夏", "夏", "夏", "秋", "秋", "秋", "冬")
	_季節[month - 1]
}

// 第11章：foreach で配列の要素を1つずつ取り出す
持ち物トーク
{
	_持ち物 = ("ひまわりの種", "小さな羽根", "青いビー玉")
	_一覧 = ""
	foreach _持ち物 ; _もの {
		_一覧 += "・" + _もの + "\n"
	}
	"\0\s[0]\1\s[10]オレの宝物を見せてやるぴ。\n\n" + _一覧 + "\w9\nぜんぶで%(ARRAYSIZE(_持ち物))個だぴ。\w9\0\s[2]……そのビー玉、わたしのじゃない？\e"
}
