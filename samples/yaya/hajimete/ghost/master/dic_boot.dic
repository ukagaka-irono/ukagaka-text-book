//==============================================================
// dic_boot.dic  起動・終了のイベント
//   はじめてのゴースト（YAYA 版） 第10章・第11章
//==============================================================

// はじめて起動したとき（SSP では、ここで何も返さないと OnBoot に進む）
OnFirstBoot
{
	"\1\s[10]\0\s[0]はじめまして！　わたし、ことね。\w9\1オレはぴーすけ、ことねの相棒だぴ。\w9\0\n\n\s[5]ユーザーさん、これからよろしくね。\e"
}

// ふだんの起動
OnBoot : nonoverlap
{
	"\1\s[10]\0\s[0]"
	--
	時間のあいさつ
	--
	"\w9\1"
	--
	"ぴーすけ参上だぴ。\e"
	"今日も元気にいくぴ。\e"
	"……まだねむいぴ。\e"
}

// 時刻によってあいさつを変える（第11章）
時間のあいさつ
{
	if hour < 5 {
		"こんな時間にこんばんは、ユーザーさん。"
	}
	elseif hour < 11 {
		"おはよう、ユーザーさん！"
	}
	elseif hour < 18 {
		"こんにちは、ユーザーさん。"
	}
	else {
		"こんばんは、ユーザーさん。"
	}
}

// 終了するとき（最後に \- を書くこと）
OnClose
{
	"\1\s[10]\0\s[0]"
	--
	"またね、ユーザーさん。"
	"今日もおつかれさま！"
	--
	"\w9\1おやすみだぴ。\w9\-"
}
